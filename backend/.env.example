PORT=5000
SERVER_URL=http://localhost:5000
N8N_WEBHOOK_URL=http://localhost:5678/webhook/firstflight-booking

# Database Configuration
PGUSER=your_pg_user
PGPASSWORD=your_pg_password
PGDATABASE=your_pg_database
PGHOST=localhost
PGPORT=5432

# XWeather Credentials (used by /api/planner/weather proxy)
XWEATHER_CLIENT_ID=your_xweather_client_id
XWEATHER_CLIENT_SECRET=your_xweather_client_secret
XWEATHER_BASE_URL=https://data.api.xweather.com

# Planner API Keys — all kept server-side only (no frontend exposure)
PLANNER_GEMINI_API_KEY=your_gemini_api_key
PLANNER_GOOGLE_PLACES_KEY=your_google_places_api_key
PLANNER_ORS_KEY=your_openrouteservice_api_key
PLANNER_OPENWEATHER_KEY=your_openweathermap_api_key
PLANNER_SERPER_API_KEY=your_serper_api_key

# AI (for IATA resolution fallback)
GEMINI_API_KEY=your_gemini_api_key
CEREBRAS_API_KEY=your_cerebras_api_key

# Notifications & Third Party Integration
RESEND_API_KEY=your_resend_api_key
META_WA_TOKEN=your_meta_wa_token
META_WA_PHONE_ID=your_meta_wa_phone_id
TWILIO_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
WASENDER_API_KEY=your_wasender_api_key

# DSA Flight Supplier
FLIGHT_PROVIDER=dsa
DSA_BASE_URL=your_dsa_base_url
DSA_API_TOKEN=your_dsa_api_token
DSA_CLIENT_ID=your_dsa_client_id
DSA_USERNAME=your_dsa_username
DSA_PASSWORD=your_dsa_password
DSA_END_USER_IP=your_server_ip

# DSA Bus Supplier
BUS_PROVIDER=dsa
DSA_BUS_BASE_URL=your_dsa_bus_base_url
DSA_BUS_API_TOKEN=your_dsa_bus_api_token
DSA_BUS_CLIENT_ID=your_dsa_bus_client_id
DSA_BUS_USERNAME=your_dsa_bus_username
DSA_BUS_PASSWORD=your_dsa_bus_password
DSA_BUS_END_USER_IP=your_server_ip

# DSA Hotel Supplier
HOTEL_PROVIDER=dsa
DSA_HOTEL_BASE_URL=your_dsa_hotel_base_url
DSA_HOTEL_API_TOKEN=your_dsa_hotel_api_token
DSA_HOTEL_CLIENT_ID=your_dsa_hotel_client_id
DSA_HOTEL_USERNAME=your_dsa_hotel_username
DSA_HOTEL_PASSWORD=your_dsa_hotel_password
DSA_HOTEL_END_USER_IP=your_server_ip
